#!/bin/bash
# record: continuous screen and microphone recording, one hotkey, no daemon.
#
#   record          start recording (1 fps screen + microphone)
#   record stop     stop, transcribe audio, file a note in the Obsidian vault
#   record status   running or not, and how much disk the videos use
#   record toggle   start if idle, stop if running: this is Option+R (skhd)
#   record screens  list displays; the red dot is what you are recording
#   record mic      which microphone the next start records from
#
# What runs where: capture (ffmpeg for the screen and the microphone,
# record-audio for what the Mac plays), the red dot overlay and the
# transcription (whisper.cpp) all run on this Mac, offline and at no cost. One thing does
# not: the optional AI CLI named by RECORD_AI (claude, cursor or copilot),
# which sends the transcript and a few screen frames to its vendor and needs
# that vendor's paid plan. It is not required, and RECORD_AI=0 turns it off
# for good. Without it the note is still written, minus the title, the tags,
# the summary and the screen description.
#
# How it stays small:
#   - screen at 1 frame per second, hardware HEVC at a low bitrate (~110 MB/hour)
#   - one file per hour, so a crash loses at most an hour
#   - every start deletes its own videos older than RECORD_DAYS (14 by default),
#     so the disk settles on a rolling buffer
#   - the Obsidian vault gets TEXT only: videos stay out of iCloud
#
# WARNING: the microphone runs the whole time. In a call you are recording
# other people too. Say so, or stop with `record stop`.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=record-lib.sh
. "$HERE/record-lib.sh"

# Optional machine-local overrides. skhd does not load ~/.zshrc, so paths
# that differ from the public defaults belong here, not in the environment.
CONFIG="${RECORD_CONFIG:-$HOME/.config/record/config}"
if [ -f "$CONFIG" ]; then
  # shellcheck disable=SC1090
  . "$CONFIG"
fi

DIR="${RECORD_DIR:-$HOME/Recordings}"
PIDFILE="$DIR/.record.pid"
SESSION="$DIR/.session"           # marker: start of the current session
MODEL="$DIR/.whisper/ggml-large-v3-turbo-q5_0.bin"
VAULT="${RECORD_VAULT:-$HOME/Documents/Obsidian}"
NOTES="${RECORD_NOTES:-$VAULT/Recordings}"
DOT="${RECORD_DOT:-$HOME/bin/record-dot}"
AUDIO_HELPER="${RECORD_AUDIO:-$HOME/bin/record-audio}"  # system audio capture
SCREEN="${RECORD_SCREEN:-0}"    # ffmpeg "Capture screen N"; red dot follows this
MIC="${RECORD_MIC:-}"           # empty: resolve the input device on every start
# The switches that are on unless the user says otherwise. Read once here so
# the defaults live in one place, and compared with is_off, which only accepts
# a deliberate 0/no/off/false.
# RECORD_AI names what writes the title, tags, summary and screen description:
# a CLI (claude, cursor, copilot) or a model server spoken to over HTTP
# (ollama, lmstudio, openai, anthropic, gemini, openrouter, custom). 0 means
# no call at all. Only the local two, ollama and lmstudio, keep the frames and
# the transcript on this Mac; every other backend sends them to its vendor.
# RECORD_CLAUDE=0 is the old name of the off switch and still counts, so a
# config written for an earlier version keeps its egress off.
AI="${RECORD_AI:-claude}"
is_off "${RECORD_CLAUDE:-1}" && AI=0
AI_VISION_MODEL="${RECORD_AI_VISION_MODEL:-}"  # empty: the backend's own default, see ai_defaults
AI_META_MODEL="${RECORD_AI_META_MODEL:-}"
AI_URL="${RECORD_AI_URL:-}"       # empty: the default endpoint of the chosen server
AI_KEY="${RECORD_AI_KEY:-}"       # empty: the provider's usual API key variable
AI_CURLRC=""                      # written per run, holds the key, mode 600
AI_FRAMES="${RECORD_AI_FRAMES:-8}"     # frames one HTTP screen call carries
AI_TIMEOUT="${RECORD_AI_TIMEOUT:-600}" # seconds one HTTP call may take
SYSTEM_AUDIO="${RECORD_SYSTEM_AUDIO:-1}" # off: the microphone alone, nothing the Mac plays
LAUNCH_APP="${RECORD_LAUNCH_APP:-}"   # empty: this tool opens no other app
DAYS="${RECORD_DAYS:-14}"       # mp4 files older than this are deleted on start
MIN_SECS=20      # a toggle this young cannot stop: it is a double tap
FRAME_MIN=8      # frames read per video, even on very short clips
FRAME_MAX=30     # cap: more frames cost and add nothing
LOCK_STALE=120   # a .lock older than this is leftover, not a live start
DOTPID="$DIR/.dot.pid"
# The system audio helper streams raw PCM into this FIFO and ffmpeg reads it
# as a second input. The .ready file is the helper's "capture is up" signal;
# the pid and the log are for stopping it and for saying why it did not start.
SYSFIFO="$DIR/.sysaudio.fifo"
SYSREADY="$DIR/.sysaudio.ready"
SYSPID="$DIR/.sysaudio.pid"
SYSLOG="$DIR/.sysaudio.log"

# The only files this tool may delete. RECORD_DIR can point anywhere, so the
# cleanup matches the exact shape ffmpeg writes (-strftime %Y-%m-%d_%H-%M.mp4)
# and never a stranger's archive that happens to live in the same folder.
CLIPS='20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]_[0-9][0-9]-[0-9][0-9].mp4'

# The AI pass is the one optional piece, and there are two ways to run it.
#
# A CLI: claude, cursor or copilot, already installed and signed in, billed to
# that vendor's plan. Each is driven the way its own headless mode wants:
# claude takes the transcript on stdin and opens the frames with its Read
# tool; cursor-agent takes everything in the prompt and opens the frames
# itself in ask mode, which is read-only, inside a workspace that is the
# scratch directory and nothing else; copilot gets the frames as attachments
# and the transcript in the prompt, with every tool switched off.
#
# Or a model server, over HTTP, in the /chat/completions shape every one of
# them speaks: ollama and lmstudio on this Mac, openai, anthropic, gemini and
# openrouter out on the network, custom for anything else that talks the same
# protocol. `record` builds the request itself, curl sends it, and the frames
# travel as base64 images in the body. The local two are the interesting case:
# with ollama or lmstudio the screen frames and the transcript never leave the
# machine, and the note still gets its title, tags, summary and screen
# description. That is the only configuration in which this tool both reads
# your screen and makes no network request at all.
#
# stderr is left alone on purpose, in both paths: a CLI that is not signed in,
# a server that is not running, a model that was never pulled, each says so
# there, and .transcribe.log is where that line has to end up.
ai_off() { is_off "$AI"; }

# Every name RECORD_AI accepts, in one place: the message for a name that is
# not among them is built from this, so a backend added here cannot be left
# out of what the tool tells the user.
AI_CLIS="claude cursor copilot"
AI_SERVERS="ollama lmstudio openai anthropic gemini openrouter custom"

ai_kind() {
  local n
  for n in $AI_CLIS;    do [ "$AI" = "$n" ] && { echo cli;  return; }; done
  for n in $AI_SERVERS; do [ "$AI" = "$n" ] && { echo http; return; }; done
  echo ""
}

ai_names() {
  echo "$AI_CLIS $AI_SERVERS" | sed -e 's/ /, /g' -e 's/\(.*\), /\1 or /'
}

# The binary behind RECORD_AI, or nothing for a name this tool does not know.
# Every server backend is curl: one program, whichever endpoint answers.
ai_bin() {
  case "$(ai_kind)" in
    http) echo curl ;;
    cli)
      case "$AI" in
        claude)  echo claude ;;
        cursor)  echo cursor-agent ;;
        copilot) echo copilot ;;
      esac ;;
    *) echo "" ;;
  esac
}

# Per-CLI models, applied only where RECORD_AI_*_MODEL left a blank. The ids
# are the ones each CLI lists itself (`cursor-agent models`, Copilot's model
# picker). A model the CLI does not carry makes the call fail and the note say
# so, on purpose: a silent downgrade would hide what was actually sent where.
ai_defaults() {
  case "$AI" in
    claude)  : "${AI_VISION_MODEL:=sonnet}";             : "${AI_META_MODEL:=haiku}" ;;
    cursor)  : "${AI_VISION_MODEL:=cursor-grok-4.6-high}"; : "${AI_META_MODEL:=cursor-grok-4.6-high}" ;;
    copilot) : "${AI_VISION_MODEL:=gemini-3.8-flash}";    : "${AI_META_MODEL:=gemini-3.8-flash}" ;;
  esac
}

# Where each server backend lives, which variable carries its key, and what it
# runs when the config names no model. RECORD_AI_URL and RECORD_AI_KEY win
# over all of it, which is what makes a compatible gateway or a second machine
# on the LAN ("http://studio.local:1234/v1") reachable without a new backend
# name here.
#
# The two local backends deliberately have no model default: `record` asks the
# server which models it has and takes the first, so a one-model Ollama works
# out of the box, and with several installed the config says which one. The
# hosted four default to a small, cheap, vision-capable model each. Model ids
# come and go; a name the endpoint does not carry makes the call fail and the
# note say so, exactly as a wrong CLI model does.
ai_http_defaults() {
  case "$AI" in
    ollama)
      : "${AI_URL:=http://localhost:11434/v1}" ;;
    lmstudio)
      : "${AI_URL:=http://localhost:1234/v1}" ;;
    openai)
      : "${AI_URL:=https://api.openai.com/v1}"
      : "${AI_KEY:=${OPENAI_API_KEY:-}}"
      : "${AI_VISION_MODEL:=gpt-5.4-mini}"; : "${AI_META_MODEL:=gpt-5.4-mini}" ;;
    anthropic)
      : "${AI_URL:=https://api.anthropic.com/v1}"
      : "${AI_KEY:=${ANTHROPIC_API_KEY:-}}"
      : "${AI_VISION_MODEL:=claude-sonnet-5}"; : "${AI_META_MODEL:=claude-haiku-4-5}" ;;
    gemini)
      : "${AI_URL:=https://generativelanguage.googleapis.com/v1beta/openai}"
      : "${AI_KEY:=${GEMINI_API_KEY:-${GOOGLE_API_KEY:-}}}"
      : "${AI_VISION_MODEL:=gemini-3.8-flash}"; : "${AI_META_MODEL:=gemini-3.8-flash}" ;;
    openrouter)
      : "${AI_URL:=https://openrouter.ai/api/v1}"
      : "${AI_KEY:=${OPENROUTER_API_KEY:-}}"
      : "${AI_VISION_MODEL:=google/gemini-3.8-flash}"
      : "${AI_META_MODEL:=google/gemini-3.8-flash}" ;;
  esac
}

# The backends that are somebody's paid API and cannot work without a key. The
# local two need none, and `custom` is whatever the user pointed it at: a
# gateway on the LAN usually wants no key either, so a missing one there is
# not an error, it is just a header that is not sent.
ai_needs_key() {
  case "$AI" in
    openai|anthropic|gemini|openrouter) return 0 ;;
    *) return 1 ;;
  esac
}

# The variable each hosted backend reads when RECORD_AI_KEY is empty, named in
# the error so the user knows which one to set.
ai_key_var() {
  case "$AI" in
    openai)     echo OPENAI_API_KEY ;;
    anthropic)  echo ANTHROPIC_API_KEY ;;
    gemini)     echo GEMINI_API_KEY ;;
    openrouter) echo OPENROUTER_API_KEY ;;
    *)          echo RECORD_AI_KEY ;;
  esac
}

# Seconds one call may take. Same reason as ai_pick_frames: curl refuses a
# config file whose max-time is not a number, and would refuse every call.
ai_timeout() {
  case "$AI_TIMEOUT" in
    ""|*[!0-9]*|0) echo 600 ;;
    *) echo "$AI_TIMEOUT" ;;
  esac
}

# curl reads the key, the timeout and the headers from a file, never from the
# command line: arguments are visible in `ps` to anything running as this user,
# and an API key has no business being there. The file lives in the scratch
# directory the run already removes on every exit path, and is written 600.
ai_curl_config() {
  ( umask 077
    {
      printf 'silent\n'
      printf 'show-error\n'
      printf 'fail-with-body\n'
      printf 'max-time = %s\n' "$(ai_timeout)"
      printf 'header = "Content-Type: application/json"\n'
      # Every one of these endpoints, the two Anthropic and Google run for
      # OpenAI clients included, takes the key as a bearer token.
      [ -n "$AI_KEY" ] && printf 'header = "Authorization: Bearer %s"\n' "$AI_KEY"
      :
    } > "$AI_CURLRC" )
}

# The first model the endpoint lists, which is what an unconfigured local
# server is asked for. Failing here is the useful signal that nothing is
# listening, and it happens before a single frame is extracted.
ai_first_model() {
  curl --config "$AI_CURLRC" --url "$AI_URL/models" | json_get 'data.0.id'
}

# Everything that has to be true before a server backend is worth calling,
# checked once, out loud. Returns 1 with AI_WHY set, and the caller turns the
# AI pass off: a note that says "nothing answered at http://localhost:11434/v1"
# is worth more than one that silently lost its summary.
ai_http_ready() {
  local first
  ai_http_defaults
  # A trailing slash in a hand-written RECORD_AI_URL would make every path
  # below a double one. Harmless on most servers, a 404 on some.
  AI_URL="${AI_URL%/}"
  AI_CURLRC="$WORK/curlrc"
  if [ -z "$(json_reader)" ]; then
    AI_WHY=nojson
    echo "RECORD_AI is \"$AI\", which answers in JSON, and neither plutil nor python3" >&2
    echo "is here to read it: no AI call." >&2
    return 1
  fi
  if [ -z "$AI_URL" ]; then
    AI_WHY=nourl
    echo "RECORD_AI is \"$AI\" and RECORD_AI_URL is empty: no endpoint to call." >&2
    return 1
  fi
  if ai_needs_key && [ -z "$AI_KEY" ]; then
    AI_WHY=nokey
    # Remembered here, while $AI still holds the backend's name: the caller
    # switches it off next, and the note is written long after.
    AI_KEY_VAR=$(ai_key_var)
    echo "RECORD_AI is \"$AI\" and no API key was found in $AI_KEY_VAR or" >&2
    echo "RECORD_AI_KEY: no AI call. Both are read from $CONFIG too." >&2
    return 1
  fi
  ai_curl_config
  if [ -z "$AI_VISION_MODEL" ] || [ -z "$AI_META_MODEL" ]; then
    if ! first=$(ai_first_model) || [ -z "$first" ]; then
      AI_WHY=unreachable
      echo "Nothing answered at $AI_URL/models (RECORD_AI=$AI): no AI call." >&2
      echo "Start the server, or name the model with RECORD_AI_VISION_MODEL and" >&2
      echo "RECORD_AI_META_MODEL to skip this check." >&2
      return 1
    fi
    : "${AI_VISION_MODEL:=$first}"
    : "${AI_META_MODEL:=$first}"
  fi
  return 0
}

AI_RULES="Write in English what the screen showed. Hard rules:
- Copy readable text LITERALLY: window or call title, URL, repo and project names, table headers and values, visible participant names.
- If text is blurry, say it is unreadable. NEVER invent a number, a name, or a URL.
- If the screen barely changes, say so in one line and list only the instants where something changes.
- Anchor every observation to the frame timestamp.
- At most 15 lines."

AI_EYES="You are the eyes of someone who missed this meeting and has to remember it."

AI_ASK="This is the audio transcript and screen description of a work session or meeting recorded on a computer. Reply in EXACTLY three lines, no other text. Start each line with its label, written out literally, colon included:
TITLE: <max 6 words, in English, specific to the content>
TAGS: <2-4 short kebab-case tags separated by space, e.g. meeting standup planning>
SUMMARY: <2-3 sentences on the content and any decisions>
The words TITLE:, TAGS: and SUMMARY: are part of the answer, not placeholders to replace: keep them."

# At most RECORD_AI_FRAMES of the lines on stdin, evenly spread over them, the
# first and the last always kept. A CLI is handed the whole hour's worth of
# frames and decides for itself how to read them; a chat request carries every
# image it names in one body, and thirty of those is a request a local model
# on a laptop will not survive. The extraction does not change: this picks
# from what was extracted, so the timestamps stay honest.
ai_pick_frames() {
  local k="$AI_FRAMES"
  # A config is edited by hand and this one is a number: anything that is not
  # falls back to the default rather than deciding, through awk's idea of
  # comparing a word with a number, that no image is sent at all.
  case "$k" in ""|*[!0-9]*|0) k=8 ;; esac
  awk -v k="$k" '
    { line[NR] = $0 }
    END {
      if (k < 1 || NR <= k) { for (i = 1; i <= NR; i++) print line[i]; exit }
      if (k == 1) { print line[1]; exit }
      for (j = 0; j < k; j++) print line[int(j * (NR - 1) / (k - 1)) + 1]
    }'
}

# One chat request, sent and read. $1 is the file holding the body. The
# assistant's message goes to stdout and nothing else does; every failure,
# a refusal from the endpoint included, goes to stderr and returns 1, so the
# caller sees an empty answer and the note says the call came back silent.
ai_post() {
  local body="$1" resp="$WORK/ai-response.json" out err=""
  rm -f "$resp"
  if curl --config "$AI_CURLRC" --url "$AI_URL/chat/completions" \
       --data-binary "@$body" --output "$resp"; then
    if out=$(json_get 'choices.0.message.content' < "$resp") && [ -n "$out" ]; then
      printf '%s\n' "$out"
      return 0
    fi
  fi
  # Every one of these APIs puts the reason in .error.message, and the ones
  # that do not (a proxy, an HTML error page) at least put something in the
  # body worth quoting.
  err=$(json_get 'error.message' < "$resp" 2>/dev/null) || err=""
  [ -n "$err" ] || err=$(LC_ALL=C tr -d '\000-\010\013-\037' < "$resp" 2>/dev/null | head -c 200)
  echo "$AI at $AI_URL did not answer: ${err:-no response body}" >&2
  return 1
}

# The screen call as a chat request: the rules and the frame times as text,
# then the frames themselves as base64 data URLs, in order. $1 is the frame
# map, which is where the paths come from.
ai_http_vision() {
  local map="$1" body="$WORK/ai-request.json" sent labels line path
  sent=$(printf '%s\n' "$map" | ai_pick_frames)
  # The model is told when each image was taken, by position rather than by
  # path: the scratch directory's name is of no use to it.
  labels=$(printf '%s\n' "$sent" | awk '{ i = index($0, "(at "); printf "image %d %s\n", NR, substr($0, i) }')
  {
    printf '{"model":"'
    printf '%s' "$AI_VISION_MODEL" | json_escape
    printf '","messages":[{"role":"user","content":[{"type":"text","text":"'
    printf '%s\nThe images below are screen frames in order. This is when each one was taken:\n\n%s\n\n%s\n' \
      "$AI_EYES" "$labels" "$AI_RULES" | json_escape
    printf '"}'
    while IFS= read -r line; do
      path="${line%%  (at *}"
      [ -f "$path" ] || continue
      printf ',{"type":"image_url","image_url":{"url":"data:image/jpeg;base64,'
      base64 < "$path" | tr -d '\n'
      printf '"}}'
    done <<EOF
$sent
EOF
    printf ']}]}'
  } > "$body"
  ai_post "$body"
}

# Title, tags and summary as a chat request. The transcript arrives on stdin,
# already cut to the size the call may send; $1 is the instruction.
ai_http_meta() {
  local body="$WORK/ai-request.json"
  {
    printf '{"model":"'
    printf '%s' "$AI_META_MODEL" | json_escape
    printf '","messages":[{"role":"user","content":"'
    { printf '%s\n\n=== TRANSCRIPT ===\n' "$1"; cat; } | json_escape
    printf '"}]}'
  } > "$body"
  ai_post "$body"
}

# One screen description. $1 is the frame map (one path and its offset per
# line), $2 the directory those frames live in. The answer goes to stdout.
ai_vision() {
  local map="$1" frames="$2" f
  if [ "$(ai_kind)" = http ]; then
    # The map carries the path of every frame, so the directory is of no use
    # here: the images go into the request body, not to a tool that opens them.
    ai_http_vision "$map"
    return
  fi
  case "$AI" in
    claude)
      claude -p "$AI_EYES
Read these screen frames with Read, one by one, in order:

$map

$AI_RULES" --model "$AI_VISION_MODEL" --allowedTools Read ;;
    cursor)
      cursor-agent -p --mode ask --trust --workspace "$frames" --output-format text \
        --model "$AI_VISION_MODEL" "$AI_EYES
Open these screen frames, JPEG files in this workspace, one by one, in order:

$map

$AI_RULES" ;;
    copilot)
      local attach=()
      while IFS= read -r f; do
        [ -n "$f" ] && attach+=(--attachment "$f")
      done < <(find "$frames" -name 'k*.jpg' | sort)
      copilot -p "$AI_EYES
The attached screen frames are in order. This is when each one was taken:

$map

$AI_RULES" -s --no-custom-instructions --no-ask-user --available-tools= \
        --model "$AI_VISION_MODEL" "${attach[@]}" ;;
  esac
}

# Title, tags and summary. The transcript arrives on stdin, already cut to the
# size the call may send; $1 is a scratch directory the CLI may treat as its
# workspace. Three lines on stdout, parsed by the caller.
ai_meta() {
  local work="$1"
  if [ "$(ai_kind)" = http ]; then
    ai_http_meta "$AI_ASK"
    return
  fi
  case "$AI" in
    claude)
      claude -p --model "$AI_META_MODEL" "$AI_ASK" ;;
    cursor)
      cursor-agent -p --mode ask --trust --workspace "$work" --output-format text \
        --model "$AI_META_MODEL" "$AI_ASK

=== TRANSCRIPT ===
$(cat)" ;;
    copilot)
      copilot -p "$AI_ASK

=== TRANSCRIPT ===
$(cat)" -s --no-custom-instructions --no-ask-user --available-tools= \
        --model "$AI_META_MODEL" ;;
  esac
}

# True when the text on stdin is a CLI saying it cannot answer rather than an
# answer. Never true for a server backend: there a refusal is an HTTP status
# and an error body, which ai_post has already read and reported, and sniffing
# the text would only let a model that wrote "not available" about the screen
# throw away its own description.
ai_refused() {
  [ "$(ai_kind)" = http ] && return 1
  grep -qiE "$AI_REFUSAL"
}

# The phrases the CLIs print instead of an answer when they cannot give one.
# Matched against stdout, because that is where a wrapped-up error lands.
AI_REFUSAL='not logged in|please run /login|invalid api key|credit balance|usage limit|unauthorized|unauthenticated|unknown model|not available|invalid model|rate limit|quota|login required|sign in'

running() {
  # the pidfile is not enough: two Option+R in a row can start a second ffmpeg
  # before the first has written the pid. The process is the truth.
  { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; } \
    || pgrep -f "avfoundation.*$DIR" >/dev/null 2>&1
}

# Option+R has no terminal: confirmation goes through here
notify() {
  # A double quote or a backslash in the message would close the AppleScript
  # string early and the notification would never appear. These messages carry
  # paths and device names now, so strip both: this is prose, not data.
  local msg
  msg=$(printf '%s' "$1" | tr -d '\\"')
  osascript -e "display notification \"$msg\" with title \"record\"" 2>/dev/null || true
}

screen_label() {
  if [ -x "$DOT" ]; then
    "$DOT" screens 2>/dev/null | awk -F'\t' -v n="$SCREEN" '$1==n { printf "%s (%s)", $3, $4; exit }'
  fi
}

show_dot() {
  hide_dot
  [ -x "$DOT" ] || return 0
  # nohup: Option+R's process exits immediately; without this the overlay dies on SIGHUP
  nohup "$DOT" on --screen "$SCREEN" --pid-file "$DOTPID" --watch-pid-file "$PIDFILE" \
    >/dev/null 2>&1 &
  disown $! 2>/dev/null || true
}

hide_dot() {
  if [ -f "$DOTPID" ]; then
    kill "$(tr -d '[:space:]' < "$DOTPID")" 2>/dev/null || true
    rm -f "$DOTPID"
  fi
  pkill -f "record-dot on" 2>/dev/null || true
}

# The system audio helper streams into the FIFO for as long as ffmpeg reads
# it and dies on its own when ffmpeg goes. This covers every other path: a
# start that failed after the helper came up, a stop that found no ffmpeg, a
# helper left over from a crash. Idempotent, and quiet when there is nothing.
stop_sysaudio() {
  if [ -f "$SYSPID" ]; then
    kill "$(tr -d '[:space:]' < "$SYSPID")" 2>/dev/null || true
    rm -f "$SYSPID"
  fi
  pkill -f "$AUDIO_HELPER capture" 2>/dev/null || true
  rm -f "$SYSFIFO" "$SYSREADY"
}

# Versions up to 0.2 recorded system audio through BlackHole and two aggregate
# devices, and switched the Mac's output to one of them for the take. A Mac
# upgraded with a take running, or one that crashed on the old version, can
# still be playing into that device, with the real output's name in
# .previous-output. Put it back once, then forget the file.
legacy_audio_cleanup() {
  [ -f "$DIR/.previous-output" ] || return 0
  if [ -x "$AUDIO_HELPER" ]; then
    "$AUDIO_HELPER" down "$(cat "$DIR/.previous-output")" >/dev/null 2>&1 || true
  fi
  rm -f "$DIR/.previous-output"
}

stop_audio() {
  stop_sysaudio
  legacy_audio_cleanup
  return 0
}

cmd="${1:-start}"
case "$cmd" in

  toggle)
    # A start in progress is never interrupted: whoever hits Option+R again
    # after two seconds wants to start, not stop. Missing this used to kill
    # the ffmpeg that had just been born, and that is how a meeting is lost.
    if [ -d "$DIR/.lock" ]; then
      lock_age=$(( $(date +%s) - $(stat -f %m "$DIR/.lock" 2>/dev/null || echo 0) ))
      if [ "$lock_age" -lt "$LOCK_STALE" ]; then
        notify "Already starting, wait."
        exit 0
      fi
      rmdir "$DIR/.lock" 2>/dev/null || true
    fi

    if running; then
      # Double-tap guard: a recording this young cannot be stopped by the
      # hotkey. To stop for real inside the window: record stop
      age=$(( $(date +%s) - $(stat -f %m "$SESSION" 2>/dev/null || echo 0) ))
      if [ "$age" -lt "$MIN_SECS" ]; then
        notify "Already recording (${age}s). Ignored: to stop, run record stop."
        exit 0
      fi
      "$0" stop
      notify "Stopped. Transcribing and filing the note."
    else
      # Feedback comes FIRST, before the slow work (audio devices, ffmpeg
      # probe). Without it the user is in the dark for seconds and taps again.
      notify "Starting recording..."
      if "$0" start; then
        label=$(screen_label)
        if [ -n "$label" ]; then
          notify "Recording $label. Red dot is on that screen."
        else
          notify "Recording screen $SCREEN + microphone. Look for the red dot."
        fi
      else
        notify "Did not start. Log: $DIR/.record.log"
      fi
    fi
    ;;

  stop)
    if running; then
      # SIGINT, not SIGKILL: ffmpeg closes the mp4 cleanly
      pid_ff=$(cat "$PIDFILE" 2>/dev/null || true)
      if [ -z "$pid_ff" ] || ! kill -0 "$pid_ff" 2>/dev/null; then
        pid_ff=$(pgrep -f "avfoundation.*$DIR" | head -1)
      fi
      [ -n "$pid_ff" ] || { echo "Cannot find the recording process."; rm -f "$PIDFILE"; hide_dot; stop_audio; exit 1; }
      kill -INT "$pid_ff"
      # wait until ffmpeg actually writes the moov atom, not a guessed sleep:
      # a long file can take more than 2 seconds and the video stays broken
      for _ in $(seq 1 50); do
        kill -0 "$pid_ff" 2>/dev/null || break
        sleep 0.2
      done
      kill -0 "$pid_ff" 2>/dev/null && { sleep 2; kill -9 "$pid_ff" 2>/dev/null || true; }
      rm -f "$PIDFILE"
      hide_dot
      stop_audio
      echo "Recording stopped. Files are in $DIR"
      nohup "$0" transcribe >"$DIR/.transcribe.log" 2>&1 &
      echo "Transcribing in the background: the note will appear in the vault, Recordings/"
      echo "Follow with: tail -f $DIR/.transcribe.log"
    else
      echo "Not recording."
      rm -f "$PIDFILE"
      hide_dot
      stop_audio
    fi
    ;;

  status)
    if running; then
      echo "Recording (pid $(cat "$PIDFILE" 2>/dev/null || pgrep -f "avfoundation.*$DIR" | head -1))."
      label=$(screen_label)
      [ -n "$label" ] && echo "Screen $SCREEN: $label"
      if [ -f "$SYSPID" ] && kill -0 "$(tr -d '[:space:]' < "$SYSPID")" 2>/dev/null; then
        echo "Audio: microphone + system audio (record-audio pid $(tr -d '[:space:]' < "$SYSPID"))"
      else
        echo "Audio: microphone only"
      fi
    else
      echo "Idle."
    fi
    if [ -d "$DIR" ]; then
      n_clips=$(find "$DIR" -maxdepth 1 -name "$CLIPS" | wc -l | tr -d ' ')
      if [ "$n_clips" -gt 0 ]; then
        size=$(find "$DIR" -maxdepth 1 -name "$CLIPS" -exec du -ch {} + 2>/dev/null | tail -1 | cut -f1)
        echo "Video disk: ${size:-unknown}  ($n_clips files)"
      else
        echo "Video disk: no recording yet in $DIR"
      fi
    else
      echo "Video disk: $DIR does not exist yet; it is created on the first start."
    fi
    ;;

  screens)
    LIST=$(ffmpeg -f avfoundation -list_devices true -i "" 2>&1 || true)
    echo "Capture screens (RECORD_SCREEN picks one; the red dot appears on it)."
    echo "Currently: SCREEN=$SCREEN"
    echo
    if [ -x "$DOT" ]; then
      "$DOT" screens | while IFS=$'\t' read -r idx _id name size flags; do
        ff=$(parse_capture_index "$LIST" "$idx")
        mark=""
        [ "$idx" = "$SCREEN" ] && mark="  <- recording this"
        extra=""
        [ -n "$flags" ] && extra="  $flags"
        printf "  %s  %-28s  %-10s  ffmpeg [%s]%s%s\n" "$idx" "$name" "$size" "${ff:-?}" "$extra" "$mark"
      done
    else
      echo "record-dot is not installed; ffmpeg devices:"
      # same set -e trap as the start branch: without the fallback, a broken
      # ffmpeg makes `record screens` swallow its own closing hints.
      echo "$LIST" | grep 'Capture screen' || echo "  (none: ffmpeg listed no capture screen)"
    fi
    echo
    echo "To record the other display: RECORD_SCREEN=1 record toggle"
    echo "Or export RECORD_SCREEN in ~/.zshrc."
    ;;

  mic)
    # The same resolution a start does, and nothing else: no device is opened,
    # so it is safe mid-take. Reads RECORD_MIC from the config file like a
    # start would, which is the point of asking here and not ffmpeg.
    LIST=$(ffmpeg -f avfoundation -list_devices true -i "" 2>&1 || true)
    if [ -n "$MIC" ]; then
      idx=$(parse_audio_index "$LIST" "$MIC")
      if [ -z "$idx" ]; then
        echo "RECORD_MIC is \"$MIC\" and no audio input on this Mac has that name."
        echo "It has to match one of these EXACTLY, spaces and capitals included:"
        echo "$LIST" | sed -n '/audio devices:/,$p' | grep '^\[AVFoundation' | grep -v 'audio devices:' | sed 's/^/  /'
        exit 1
      fi
      echo "$(audio_name_at "$LIST" "$idx")  (RECORD_MIC, ffmpeg audio [$idx])"
    else
      idx=$(resolve_audio_index "$LIST")
      if [ -z "$idx" ]; then
        echo "No usable audio input: every input on this Mac is a loopback or a"
        echo "virtual meeting device. Set RECORD_MIC in $CONFIG."
        exit 1
      fi
      echo "$(audio_name_at "$LIST" "$idx")  (resolved on every start, ffmpeg audio [$idx])"
    fi
    if is_off "$SYSTEM_AUDIO"; then
      echo "System audio: off (RECORD_SYSTEM_AUDIO), so on a call only your own voice."
    else
      echo "System audio: what the Mac plays, captured by record-audio and mixed in."
    fi
    ;;

  transcribe)
    [ -f "$MODEL" ] || { echo "Whisper model missing at $MODEL"; exit 1; }
    [ -f "$SESSION" ] || { echo "No session to transcribe."; exit 0; }

    # NUL-delimited into an array, never a bare string walked with `for f in
    # $FILES`. That word split on every space, so a RECORD_DIR whose name has
    # one ("~/My Recordings") turned two files into four bogus paths, ffmpeg
    # failed on the first of them and set -e killed the whole background run:
    # no note, no error anywhere the user looks, only .transcribe.log.
    FILES=()
    while IFS= read -r -d '' f; do
      FILES+=("$f")
    done < <(find "$DIR" -maxdepth 1 -name "$CLIPS" -newer "$SESSION" -print0 | sort -z)
    [ "${#FILES[@]}" -gt 0 ] || { echo "No new video."; exit 0; }

    # Whether the AI CLI runs at all is settled once, here, and the reason a
    # note ends up without a summary is remembered so the note can say it:
    # a choice (off), a typo (unknown name), a missing binary, or a CLI that
    # exists and answered nothing. The last used to be indistinguishable from
    # the first, with the error swallowed by 2>/dev/null.
    # One scratch directory for the whole run, removed on every exit path,
    # including a failed ffmpeg under set -e. The old `mktemp -t record`.wav
    # left an empty stub in TMPDIR for every mp4 ever transcribed: mktemp
    # created one path and the .wav suffix made the real file a different one.
    # It is created before the checks below because a server backend keeps its
    # curl config, the one file that holds the API key, inside it.
    WORK=$(mktemp -d -t record-work)
    trap 'rm -rf "$WORK"' EXIT

    AI_SILENT=0
    AI_WHY=""
    AI_KEY_VAR=""
    AI_BIN=$(ai_bin)
    AI_WHERE="$AI_BIN"
    if ai_off; then
      AI_WHY="off"
      echo "RECORD_AI is off: no AI call. The note gets the full transcript,"
      echo "a generic title and no screen description."
    elif [ -z "$AI_BIN" ]; then
      AI_WHY="unknown"
      echo "RECORD_AI is \"$AI\", which is not $(ai_names): no AI call." >&2
      echo "The note gets the full transcript, a generic title and no screen description."
      AI=0
    elif ! command -v "$AI_BIN" >/dev/null 2>&1; then
      AI_WHY="missing"
      echo "The \`$AI_BIN\` CLI is not installed (RECORD_AI=$AI): no AI call." >&2
      AI=0
    elif [ "$(ai_kind)" = http ] && ! ai_http_ready; then
      # ai_http_ready has already said which of the four things is wrong and
      # set AI_WHY to it. The note repeats it below.
      echo "The note gets the full transcript, a generic title and no screen description."
      AI=0
    else
      ai_defaults
      [ "$(ai_kind)" = http ] && AI_WHERE="$AI_URL"
      echo "AI: $AI ($AI_WHERE), screen frames with $AI_VISION_MODEL, title and summary with $AI_META_MODEL."
    fi

    TEXT=""
    VISUAL=""
    SKIPPED=""
    for f in "${FILES[@]}"; do
      wav="$WORK/audio.wav"
      rm -f "$wav"
      # One unreadable segment must never cost the whole day. A forced
      # shutdown or a dead battery leaves the last mp4 without its moov atom,
      # and that is precisely the case the README promises still works. Under
      # set -e an unguarded ffmpeg here aborted the background run on that
      # file, threw away every hour already transcribed, wrote no note at all,
      # and left one "moov atom not found" line in a log nobody opens.
      if ! ffmpeg -y -hide_banner -loglevel error -i "$f" -ar 16000 -ac 1 "$wav" 2>&1; then
        echo "Skipped $(basename "$f"): could not be decoded, probably an interrupted segment."
        SKIPPED="$SKIPPED
- \`$f\` (unreadable, probably interrupted)"
        rm -f "$wav"
        continue
      fi
      # -l auto: a meeting can switch language mid sentence, and forcing one
      # language mistranscribes everything said in the other.
      # timestamps stay: they are the correlation with the video.
      # Guarded like the ffmpeg call above, and for the same reason. `|| true`
      # was worse than no guard: it produced a heading with nothing under it,
      # discarded the error, left the file out of SKIPPED, and let the note
      # claim the transcript was complete. An hour lost that way is
      # indistinguishable from an hour in which nobody spoke.
      # stderr is kept apart from the transcript: whisper.cpp 0.17 announces
      # its backends there on every run, and captured with 2>&1 those lines
      # opened every transcript section in the note. It is shown only when
      # the run failed, which is when it says something.
      if ! chunk=$(whisper-cli -m "$MODEL" -f "$wav" -l auto -np 2>"$WORK/whisper.err"); then
        echo "Skipped $(basename "$f"): whisper-cli failed to transcribe it."
        tail -5 "$WORK/whisper.err" 2>/dev/null | sed 's/^/  /'
        SKIPPED="$SKIPPED
- \`$f\` (transcription failed)"
        rm -f "$wav"
        continue
      fi
      rm -f "$wav"
      TEXT="$TEXT
## $(basename "$f" .mp4 | tr '_' ' ')
$chunk
"

      # the screen is half the information: in a meeting that shares a
      # dashboard, audio alone does not say what was on screen.
      # frames are spread over the whole duration, not on scene cuts: in a
      # call the webcams change constantly and would bias the first seconds.
      # All of it exists only to feed the AI CLI, so RECORD_AI=0 skips the
      # extraction too rather than writing JPEGs nobody will read.
      if ai_off; then
        continue
      fi
      duration=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$f" 2>/dev/null || echo 0)
      n_frame=$(awk -v d="$duration" -v lo="$FRAME_MIN" -v hi="$FRAME_MAX" \
        'BEGIN{ if(d<=0){print lo; exit} n=int(d/25+0.5); if(n<lo)n=lo; if(n>hi)n=hi; print n }')
      fps=$(awk -v d="$duration" -v n="$n_frame" 'BEGIN{ if(d<=0)d=1; printf "%.6f", n/d }')
      frames="$WORK/frames"
      rm -rf "$frames"
      mkdir -p "$frames"
      ffmpeg -y -hide_banner -loglevel error -i "$f" \
        -vf "fps=$fps,scale=1400:-1" -q:v 4 "$frames/k%03d.jpg" 2>/dev/null || true

      listing=$(find "$frames" -name 'k*.jpg' | sort)
      if [ -n "$listing" ]; then
        map=$(echo "$listing" | awk -v n="$n_frame" -v d="$duration" \
          '{ t=int((NR-1)*d/n); printf "%s  (at %d:%02d from start)\n", $0, int(t/60), t%60 }')
        descr=$(ai_vision "$map" "$frames" || true)
        if printf '%s\n' "$descr" | ai_refused; then
          echo "Screen read skipped: $AI did not answer ($(echo "$descr" | head -1))" >&2
          descr=""
        fi
        [ "${#descr}" -lt 60 ] && descr=""
        [ -n "$descr" ] || AI_SILENT=1
        [ -n "$descr" ] && VISUAL="$VISUAL
### $(basename "$f" .mp4 | tr '_' ' ')
$descr
"
      fi
      rm -rf "$frames"
    done

    STAMP=$(date '+%Y-%m-%d %H%M')
    DAY=$(date '+%Y-%m-%d')

    # title, tags, summary from content. If the CLI does not answer, the note
    # is still written, raw.
    # The one call that costs money per session. Off means no call and an
    # empty META, which is exactly the shape a failed call already produced:
    # the fallbacks below fill in a generic title and the note is written.
    META=""
    if ! ai_off; then
      META=$(printf '%s\n\n=== WHAT WAS ON SCREEN ===\n%s\n' "$TEXT" "$VISUAL" \
        | head -c 30000 | ai_meta "$WORK" || true)
      if printf '%s\n' "$META" | ai_refused; then
        echo "Title and summary skipped: $AI did not answer ($(echo "$META" | head -1))" >&2
        META=""
      fi
      [ -n "$META" ] || AI_SILENT=1
      # A coding CLI echoes the labels back; a small local model often reads
      # them as placeholders and answers with the three values alone. That
      # parsed as nothing, and the note came out titled "Recorded session",
      # tagged "recording", with no summary and no sign that a good answer had
      # been thrown away. When the reply is exactly the three lines that were
      # asked for and not one of them is labelled, the order is the only thing
      # those lines can be, so put the labels back. Anything else is said out
      # loud instead of being guessed at.
      if [ -n "$META" ] && [ -z "$(printf '%s\n' "$META" | grep '^\(TITLE\|TAGS\|SUMMARY\):')" ]; then
        BARE=$(printf '%s\n' "$META" | grep -v '^[[:space:]]*$')
        if [ "$(printf '%s\n' "$BARE" | wc -l | tr -d ' ')" = 3 ]; then
          META=$(printf '%s\n' "$BARE" | awk '
            NR == 1 { print "TITLE: " $0 }
            NR == 2 { print "TAGS: " $0 }
            NR == 3 { print "SUMMARY: " $0 }')
          echo "$AI answered without the TITLE/TAGS/SUMMARY labels; read in order instead." >&2
        else
          echo "Title, tags and summary skipped: $AI answered in a shape with no TITLE/TAGS/SUMMARY line in it." >&2
          META=""
          AI_SILENT=1
        fi
      fi
      # Copilot wraps what it prints at 100 columns, terminal or not, so a
      # summary of any length arrives as several lines and only the first
      # would be kept. Fold every continuation line back onto its field.
      META=$(printf '%s\n' "$META" | awk '
        /^(TITLE|TAGS|SUMMARY):/ { if (line != "") print line; line = $0; next }
        { sub(/^[[:space:]]+/, ""); if (line != "" && $0 != "") line = line " " $0 }
        END { if (line != "") print line }')
    fi

    TITLE=$(echo "$META" | sed -n 's/^TITLE: *//p' | head -1)
    TAGS=$(echo "$META"   | sed -n 's/^TAGS: *//p'    | head -1)
    SUMMARY=$(echo "$META" | sed -n 's/^SUMMARY: *//p' | head -1)
    [ -n "$TITLE" ] || TITLE="Recorded session"
    [ -n "$TAGS" ]   || TAGS="recording"

    # A note filed outside a vault is a note nobody ever opens, and until now
    # nothing checked: on a machine with no Obsidian at all this happily did
    # mkdir -p on the default ~/Documents/Obsidian/Recordings and reported
    # success. Every real vault has a .obsidian directory at its root, so walk
    # up from the notes folder and look for one. The note is written either
    # way, the transcription is never thrown away, but a miss is said out loud.
    VAULT_ROOT=$(vault_root "$NOTES")

    mkdir -p "$NOTES"
    NOTE="$NOTES/$STAMP $(echo "$TITLE" | tr -d '/:').md"
    {
      echo "---"
      echo "tags: [$(echo "$TAGS" | tr ' ' ',')]"
      echo "date: $DAY"
      echo "type: recording"
      echo "---"
      echo
      echo "# $TITLE"
      echo
      [ -n "$SUMMARY" ] && { echo "$SUMMARY"; echo; }
      # Every reason gets said. An absent CLI used to produce a note identical
      # to a deliberate off switch, with the error swallowed by 2>/dev/null, so
      # the reader had no way to tell a choice from a fault.
      case "$AI_WHY" in
        off)
          echo "*No title, tags, summary or screen description: RECORD_AI is off.*"
          echo "*The transcript below is what was said.*"
          echo ;;
        unknown)
          echo "*No title, tags, summary or screen description: RECORD_AI is set to*"
          echo "*\`${RECORD_AI:-}\`, which is not $(ai_names). The transcript below is*"
          echo "*what was said.*"
          echo ;;
        missing)
          echo "*No title, tags, summary or screen description: the \`$AI_BIN\` CLI*"
          echo "*is not installed. The transcript below is what was said.*"
          echo ;;
        nokey)
          echo "*No title, tags, summary or screen description: RECORD_AI is*"
          echo "*\`${RECORD_AI:-}\` and no API key was found in $AI_KEY_VAR or*"
          echo "*RECORD_AI_KEY. The transcript below is what was said.*"
          echo ;;
        nourl)
          echo "*No title, tags, summary or screen description: RECORD_AI is*"
          echo "*\`${RECORD_AI:-}\` and RECORD_AI_URL names no endpoint. The transcript*"
          echo "*below is what was said.*"
          echo ;;
        unreachable)
          echo "*No title, tags, summary or screen description: nothing answered at*"
          echo "*\`$AI_URL\` (RECORD_AI is \`${RECORD_AI:-}\`), so the model was never*"
          echo "*asked. The transcript below is what was said.*"
          echo ;;
        nojson)
          echo "*No title, tags, summary or screen description: RECORD_AI is*"
          echo "*\`${RECORD_AI:-}\`, which answers in JSON, and neither plutil nor*"
          echo "*python3 is here to read it. The transcript below is what was said.*"
          echo ;;
        *)
          if [ "$AI_SILENT" = 1 ]; then
            echo "*\`$AI\` did not answer for part or all of this note (model*"
            echo "*$AI_VISION_MODEL / $AI_META_MODEL): what it said is in \`.transcribe.log\`*"
            echo "*next to the videos. The transcript below is what was said.*"
            echo
          fi ;;
      esac
      echo "**Video** (on the Mac, deleted after $DAYS days):"
      for f in "${FILES[@]}"; do echo "- \`$f\`"; done
      if [ -n "$SKIPPED" ]; then
        echo
        echo "**Not transcribed** (the file could not be decoded, so this part"
        echo "of the session is missing from the transcript below):"
        echo "$SKIPPED"
      fi
      echo
      echo "*Timestamps in the transcript are relative to the matching hour's video:*"
      echo "*each section below is named after its file.*"
      if [ -n "$VISUAL" ]; then
        echo
        echo "## What was on screen"
        echo "$VISUAL"
      fi
      echo
      echo "## Transcript"
      echo "$TEXT"
    } > "$NOTE"

    rm -f "$SESSION"
    echo "Note created: $NOTE"
    if [ -z "$VAULT_ROOT" ]; then
      echo
      echo "WARNING: that folder is not inside an Obsidian vault. There is no"
      echo ".obsidian directory above it, so Obsidian will never list this note"
      echo "and you will not find it where the README says it goes."
      echo "Written to:  $NOTES"
      echo "To fix it:   set RECORD_VAULT to your vault root in $CONFIG"
      echo "             (or RECORD_NOTES to a folder inside the vault)."
      echo "Nothing was lost: the note above is complete, move it when you like."
      notify "Note filed OUTSIDE any Obsidian vault, in $NOTES. Set RECORD_VAULT in $CONFIG."
    fi
    ;;

  start)
    # only a real start creates the directory: status and the usage error must
    # not litter a machine that has never recorded anything.
    mkdir -p "$DIR"
    if ! mkdir "$DIR/.lock" 2>/dev/null; then
      echo "A start is already in progress."
      exit 0
    fi
    trap 'rmdir "$DIR/.lock" 2>/dev/null' EXIT

    if running; then
      echo "Already recording."
      exit 0
    fi

    found=$(find "$DIR" -maxdepth 1 -name "$CLIPS" -mtime +"$DAYS" | wc -l | tr -d ' ')
    if [ "$found" -gt 0 ]; then
      find "$DIR" -maxdepth 1 -name "$CLIPS" -mtime +"$DAYS" -delete
      echo "Cleanup: deleted $found videos older than $DAYS days."
    fi

    # The log belongs to this start and nothing else: truncated here, appended
    # to from here on, so `tail` after a failure never shows a previous run.
    : > "$DIR/.record.log"

    # device indices change (iPhone plugged in, OBS...): resolve by name
    # on every start
    LIST=$(ffmpeg -f avfoundation -list_devices true -i "" 2>&1 || true)
    VIDEO=$(parse_capture_index "$LIST" "$SCREEN")
    # An exact name (RECORD_MIC) is matched as given. Otherwise the input is
    # resolved from the device list: the built-in microphone is named after
    # the Mac model, so no single hardcoded string can be right on more than
    # one machine.
    if [ -n "$MIC" ]; then
      AUDIO=$(parse_audio_index "$LIST" "$MIC")
    else
      AUDIO=$(resolve_audio_index "$LIST")
    fi
    if [ -z "$VIDEO" ] || [ -z "$AUDIO" ]; then
      [ -z "$VIDEO" ] && echo "Cannot find Capture screen $SCREEN (see: record screens)."
      if [ -z "$AUDIO" ]; then
        if [ -n "$MIC" ]; then
          # The name the user typed, quoted, because this failure is almost
          # always a near miss: a shortened name, a missing word, the wrong
          # capital. The device lookup used to accept a prefix and hand ffmpeg
          # a mangled index, so the same typo arrived here as a bare "Did not
          # start" with nothing anywhere that named the cause.
          echo "RECORD_MIC is \"$MIC\" and no audio input on this Mac has that name."
          echo "It has to match one of the audio devices below EXACTLY, spaces and"
          echo "capitals included. Set it in $CONFIG, or leave it empty and record"
          echo "picks the microphone itself."
          echo "To see the names again at any time:"
          echo "  ffmpeg -f avfoundation -list_devices true -i \"\""
        else
          echo "Cannot find any usable audio input. Set RECORD_MIC to the exact"
          echo "device name from the list below, in $CONFIG."
        fi
      fi
      echo "Devices seen:"
      # `|| echo` is not cosmetic: a bare pipeline here exits 1 under set -e
      # when ffmpeg is broken and lists nothing, and the script would die on
      # this line with only "Did not start" on screen. ffmpeg missing from
      # skhd's PATH is a documented first-run failure, so this is the likely
      # path, not the exotic one.
      echo "$LIST" | grep '^\[AVFoundation' || echo "  (none: ffmpeg listed no AVFoundation device at all)"
      hide_dot
      exit 1
    fi
    MIC_NAME=$(audio_name_at "$LIST" "$AUDIO")

    # System audio: what the Mac plays, the other side of a call included.
    # record-audio captures it natively (ScreenCaptureKit) and streams it into
    # a FIFO that ffmpeg reads as a second input. Nothing is routed, no device
    # is switched, the volume keys keep working. The helper touches
    # .sysaudio.ready once the capture is up and a helper that fails exits
    # before that, so waiting on the file tells "ready" from "failed" without
    # guessing. Either way the recording starts: without system audio it is
    # the microphone alone, and the reason is in .sysaudio.log and below.
    stop_sysaudio
    SYS_INPUT=()
    if is_off "$SYSTEM_AUDIO"; then
      echo "System audio is off (RECORD_SYSTEM_AUDIO): recording the microphone only."
    elif [ ! -x "$AUDIO_HELPER" ]; then
      echo "record-audio is not at $AUDIO_HELPER: recording the microphone only. Run ./install.sh to build it."
    else
      mkfifo "$SYSFIFO"
      : > "$SYSLOG"
      nohup "$AUDIO_HELPER" capture "$SYSFIFO" --ready "$SYSREADY" >>"$SYSLOG" 2>&1 &
      echo $! > "$SYSPID"
      for _ in $(seq 1 50); do
        [ -f "$SYSREADY" ] && break
        kill -0 "$(cat "$SYSPID")" 2>/dev/null || break
        sleep 0.1
      done
      if [ -f "$SYSREADY" ]; then
        SYS_INPUT=(-thread_queue_size 1024 -f f32le -ar 48000 -ac 2 -i "$SYSFIFO")
      else
        echo "System audio unavailable, recording the microphone only. record-audio said:"
        tail -3 "$SYSLOG" 2>/dev/null | sed 's/^/  /'
        stop_sysaudio
      fi
    fi
    if [ "${#SYS_INPUT[@]}" -gt 0 ]; then
      # Mono out: the microphone at full level plus system audio at half, the
      # balance the old BlackHole mix had. aresample=async lets the microphone
      # clock drift against the pipe without the mixer stalling or the two
      # tracks sliding apart over an hour. duration=first: the take ends when
      # the microphone input does, and a helper that dies early only costs
      # the system audio from that moment on.
      MIX=(-filter_complex "[0:a]aresample=async=1,aformat=channel_layouts=mono[mic];[1:a]aformat=channel_layouts=mono[sys];[mic][sys]amix=inputs=2:duration=first:weights='1 0.5':normalize=0[a]" -map 0:v -map "[a]")
      echo "Audio: $MIC_NAME + system audio"
    else
      MIX=(-ac 1)
      echo "Audio: $MIC_NAME only"
    fi

    touch "$SESSION"
    # a leftover pidfile from a crash would make the overlay think ffmpeg is
    # already dead and exit. ffmpeg has not started yet, so this file is stale.
    rm -f "$PIDFILE"
    show_dot

    # capture at 5 fps (the driver rejects 1 fps), keep 1 fps on the way out.
    # hardware HEVC: CPU near zero. One file per hour, name = date and time.
    # The FIFO input is spliced in only when the helper came up: on bash 3.2
    # an empty array expanded under set -u is an error, hence the idiom.
    nohup ffmpeg -hide_banner -loglevel error -nostdin \
      -thread_queue_size 1024 -f avfoundation -framerate 5 -capture_cursor 1 -i "${VIDEO}:${AUDIO}" \
      ${SYS_INPUT[@]+"${SYS_INPUT[@]}"} \
      -r 1 -c:v hevc_videotoolbox -b:v 200k -tag:v hvc1 \
      -c:a aac "${MIX[@]}" -b:a 48k \
      -f segment -segment_time 3600 -reset_timestamps 1 -strftime 1 \
      "$DIR/%Y-%m-%d_%H-%M.mp4" \
      >>"$DIR/.record.log" 2>&1 &

    echo $! > "$PIDFILE"

    # confirm when the first segment exists, not after a fixed sleep:
    # this shortens the blind window where the user does not know if it is on
    for _ in $(seq 1 40); do
      running || break
      [ -n "$(find "$DIR" -maxdepth 1 -name "$CLIPS" -newer "$SESSION" -print -quit 2>/dev/null)" ] && break
      sleep 0.25
    done

    if running; then
      # Only now, with the capture confirmed: a missing app used to abort the
      # start under set -e with the capture half set up. Optional by default,
      # opt in with RECORD_LAUNCH_APP in the config file.
      if [ -n "$LAUNCH_APP" ]; then
        if open -a "$LAUNCH_APP" >/dev/null 2>&1; then
          echo "Opened $LAUNCH_APP."
        else
          echo "Note: could not open \"$LAUNCH_APP\" (RECORD_LAUNCH_APP). Recording continues."
        fi
      fi
      label=$(screen_label)
      echo "Recording: ${label:-screen $SCREEN} at 1 fps, one file per hour in $DIR"
      echo "Red dot is on that display. To stop (and transcribe): record stop"
    else
      hide_dot
      stop_audio
      echo "ffmpeg did not start. Last lines of the log:"
      tail -5 "$DIR/.record.log"
      if grep -qiE "not permitted|permission|denied|TCC" "$DIR/.record.log" 2>/dev/null; then
        echo
        echo "Looks like a permission issue: System Settings > Privacy and"
        echo "Security > Screen Recording, enable skhd and Terminal."
      fi
      rm -f "$PIDFILE"
      exit 1
    fi
    ;;

  *)
    echo "Usage: record [start|stop|status|toggle|screens|mic|transcribe]"
    exit 1
    ;;
esac
